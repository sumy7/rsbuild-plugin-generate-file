{
  "name": "rsbuild-plugin-generate-file",
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "description": "A plugin for rsbuild to generate file",
  "keywords": ["rsbuild", "plugin", "generate", "file"],
  "author": "sumy7 <sumyggsun@gmail.com>",
  "homepage": "https://github.com/sumy7/rsbuild-plugin-generate-file#readme",
  "bugs": {
    "url": "https://github.com/sumy7/rsbuild-plugin-generate-file/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumy7/rsbuild-plugin-generate-file.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "biome check .",
    "lint:write": "biome check . --write",
    "prepare": "simple-git-hooks && npm run build",
    "test": "playwright test",
    "bump": "npx bumpp"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint:write"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "js-yaml": "^4.1.0",
    "mime-types": "^2.1.35",
    "picocolors": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.51.1",
    "@rsbuild/core": "^1.3.1",
    "@rslib/core": "^0.6.1",
    "@types/ejs": "^3.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.13.14",
    "nano-staged": "^0.8.0",
    "playwright": "^1.51.1",
    "simple-git-hooks": "^2.12.1",
    "typescript": "^5.8.2"
  },
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@rsbuild/core": "1.x"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.7.0"
}
